-- out/cmd/vorpal/main.go --
// Code generated by build-configs. DO NOT EDIT.
// This file is generated by build-configs. Update it only through
// build-configs.yaml, then regenerate with `build-configs generate`.
// Do not edit it by hand. Listing a path in .bcignore opts that file
// out of generation.

package main

import (
	"log"

	api "github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/api/artifact"
	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/artifact"
	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/artifact/language"
	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/config"
)

// frontend is the Vorpal artifact holding the static build output.
const frontend = "quirk-frontend-portal"

// buildScript installs the locked dependencies, runs the package.json build
// script under the bun runtime, since the sandbox has no node, and copies its
// output directory into the artifact.
const buildScript = `set -euo pipefail
pushd "./source/quirk-frontend-portal"
bun install --frozen-lockfile
bun --bun run build
test -d "dist"
mkdir -p "$VORPAL_OUTPUT"
cp -R "dist/." "$VORPAL_OUTPUT/"
popd`

func main() {
	ctx := config.GetContext()

	var tools []*string
	for _, alias := range []string{
		"gitleaks:8.30.1",
		"jq:1.8.1",
		"just:1.45.0",
		"rumdl:0.3.2",
		"openapi-generator-cli:7.18.0",
		"openjdk:25.0.1",
	} {
		tool, err := ctx.FetchArtifactAlias(alias)
		if err != nil {
			log.Fatalf("failed fetching %s alias: %v", alias, err)
		}
		tools = append(tools, tool)
	}

	// The TypeScript development environment carries the SDK's bun.
	_, err := language.NewTypeScriptDevelopmentEnvironment("quirk-frontend-portal-dev", config.SYSTEMS).
		WithArtifacts(tools).
		Build(ctx)
	if err != nil {
		log.Fatalf("failed building development environment: %v", err)
	}

	bun, err := artifact.Bun(ctx)
	if err != nil {
		log.Fatalf("failed building bun: %v", err)
	}

	step, err := artifact.Shell(ctx, []*string{bun}, []string{}, buildScript, nil)
	if err != nil {
		log.Fatalf("failed preparing %s build step: %v", frontend, err)
	}

	_, err = artifact.NewArtifact(frontend, []*api.ArtifactStep{step}, config.SYSTEMS).
		WithSources([]*api.ArtifactSource{source(frontend)}).
		Build(ctx)
	if err != nil {
		log.Fatalf("failed building %s: %v", frontend, err)
	}

	if err := ctx.Run(); err != nil {
		log.Fatalf("failed running vorpal: %v", err)
	}
}

// source returns the source for the artifact called name: only the listed
// paths, since Vorpal ignores .gitignore and uploads the source to the
// registry, and never the build output or node_modules, so a local build or
// install never changes the artifact digest.
func source(name string) *api.ArtifactSource {
	src := artifact.NewArtifactSource(name, ".").
		WithExcludes([]string{
			"dist",
			"node_modules",
		}).
		WithIncludes([]string{
			"bun.lock",
			"bunfig.toml",
			"index.html",
			"package.json",
			"postcss.config",
			"public",
			"src",
			"tailwind.config",
			"tsconfig",
			"vite.config",
			"env",
		}).
		Build()

	return &src
}
-- out/justfile --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

# build runs the package.json build script natively into dist/. CI
# runs `package` instead.
build: install
    bun --bun run build

generate: install
    #!/usr/bin/env bash
    set -euxo pipefail
    openapi-generator-cli generate --input-spec src/api/portal.json --generator-name typescript-axios --output src/client

check: install generate
    bun --bun run lint
    bun --bun run build:tsc

doc-validate:
    rumdl check --no-cache --deny-config-warnings .

install:
    bun install --frozen-lockfile

# package builds the Vorpal artifact called name, the static build output by
# default.
package name="quirk-frontend-portal":
    vorpal build --path '{{ name }}'

secret-scan:
    gitleaks git --no-banner --redact --exit-code 1 --log-opts=HEAD .

# vuln-scan audits the locked dependencies against the npm advisory database.
vuln-scan: install
    bun audit
