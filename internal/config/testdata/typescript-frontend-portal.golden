    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": [
        "This file is generated by build-configs. Update it only through build-configs.yaml, then regenerate with `build-configs generate`. Do not edit it by hand. Listing a path in .bcignore opts that file out of generation."
    ],
