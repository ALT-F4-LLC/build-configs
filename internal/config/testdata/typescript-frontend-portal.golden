-- out/.github/vorpal-shell.sh --
#!/usr/bin/env bash
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

# Step shell for CI: runs the step script ($1) inside the dev Vorpal
# environment. The activate script sets PATH, then runs its arguments.
set -euo pipefail

exec "$(vorpal build --path 'quirk-frontend-portal-dev')/bin/activate" bash -e "$1"
-- out/.github/workflows/ci.yaml --
---
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

name: ci

on:
  push:
    branches: [main]
  pull_request:

jobs:
  check:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - run: just secret-scan
        shell: bash .github/vorpal-shell.sh {0}
      - run: just doc-validate
        shell: bash .github/vorpal-shell.sh {0}
      - run: just check
        shell: bash .github/vorpal-shell.sh {0}
      - run: just vuln-scan
        shell: bash .github/vorpal-shell.sh {0}

  build:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    needs:
      - check
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
      - uses: actions/checkout@v7
      - run: just generate
        shell: bash .github/vorpal-shell.sh {0}
      - run: just package "quirk-frontend-portal"
        shell: bash .github/vorpal-shell.sh {0}
