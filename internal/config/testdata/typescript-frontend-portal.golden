-- out/.github/vorpal-shell.sh --
#!/usr/bin/env bash
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

# Step shell for CI: runs the step script ($1) inside the dev Vorpal
# environment. The activate script sets PATH, then runs its arguments.
set -euo pipefail

exec "$(vorpal build --path 'quirk-frontend-portal-dev')/bin/activate" bash -e "$1"
-- out/.github/workflows/ci.yaml --
---
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

name: ci

on:
  push:
    branches: [main]
  pull_request:

jobs:
  check:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - run: just secret-scan
        shell: bash .github/vorpal-shell.sh {0}
      - run: just doc-validate
        shell: bash .github/vorpal-shell.sh {0}
      - run: just check
        shell: bash .github/vorpal-shell.sh {0}
      - run: just vuln-scan
        shell: bash .github/vorpal-shell.sh {0}

  build:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    needs:
      - check
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
      - uses: actions/checkout@v7
      - run: just generate
        shell: bash .github/vorpal-shell.sh {0}
      - run: just package "quirk-frontend-portal"
        shell: bash .github/vorpal-shell.sh {0}
-- out/Vorpal.toml --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

language = "typescript"

[source]
includes = [
    "bun.lock",
    "bunfig.toml",
    "package.json",
    "src/vorpal.ts",
    "tsconfig.json"
]

[source.typescript]
entrypoint = "src/vorpal.ts"
-- out/justfile --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

# build runs the package.json build script natively into dist/. CI
# runs `package` instead.
build: install
    bun --bun run build:prod

generate: install
    #!/usr/bin/env bash
    set -euxo pipefail
    openapi-generator-cli generate --input-spec src/api/portal.json --generator-name typescript-axios --output src/client

check: install generate
    bun --bun run lint
    bun --bun run build:tsc

doc-validate:
    rumdl check --no-cache --deny-config-warnings .

install:
    bun install --frozen-lockfile

# package builds the Vorpal artifact called name, the static build output by
# default.
package name="quirk-frontend-portal":
    vorpal build --path '{{ name }}'

secret-scan:
    gitleaks git --no-banner --redact --exit-code 1 --log-opts=HEAD .

# vuln-scan audits the locked dependencies against the npm advisory database.
vuln-scan: install
    bun audit
-- out/src/vorpal.ts --
// This file is generated by build-configs. Update it only through
// build-configs.yaml, then regenerate with `build-configs generate`.
// Do not edit it by hand. Listing a path in .bcignore opts that file
// out of generation.

import {
  Artifact,
  ArtifactSource,
  ConfigContext,
  SYSTEMS,
  TypeScriptDevelopmentEnvironment,
  getSystemStr,
  shell,
} from "@altf4llc/vorpal-sdk";

// frontend is the Vorpal artifact holding the static build output.
const frontend = "quirk-frontend-portal";

// devEnvironment is the development environment the dev shell and CI load.
const devEnvironment = "quirk-frontend-portal-dev";

// tools are the Vorpal aliases the development environment adds to bun.
const tools: string[] = [
  "gitleaks:8.30.1",
  "jq:1.8.1",
  "just:1.45.0",
  "rumdl:0.3.2",
  "openapi-generator-cli:7.18.0",
  "openjdk:25.0.1",
];

// sourceExcludes and sourceIncludes bound the frontend source: only the
// listed paths, since Vorpal ignores .gitignore and uploads the source to the
// registry, and never the build output, node_modules or this program, so a
// local build, an install or a config change never changes the digest.
const sourceExcludes: string[] = [
  "dist",
  "node_modules",
  "src/vorpal.ts",
];

const sourceIncludes: string[] = [
  "bun.lock",
  "env",
  "index.html",
  "package.json",
  "postcss.config.js",
  "src",
  "tailwind.config.js",
  "tsconfig.json",
  "tsconfig.node.json",
  "vite.config.ts",
];

// buildScript installs the locked dependencies, runs the package.json build
// script under the bun runtime, since the sandbox has no node, and copies its
// output directory into the artifact.
const buildScript = [
  "set -euo pipefail",
  "pushd \"./source/quirk-frontend-portal\"",
  "bun install --frozen-lockfile",
  "bun --bun run build:prod",
  "test -d \"dist\"",
  "mkdir -p \"$VORPAL_OUTPUT\"",
  "cp -R \"dist/.\" \"$VORPAL_OUTPUT/\"",
  "popd",
].join("\n");

// bunVersion and buildBun copy the SDK's Bun builder, which
// @altf4llc/vorpal-sdk 0.6.0 does not export. The inputs match it, so this
// is the bun the development environment already carries.
const bunVersion = "1.4.4";

function bunTarget(system: string): string {
  switch (system) {
    case "aarch64-darwin":
      return "darwin-aarch64";
    case "aarch64-linux":
      return "linux-aarch64";
    case "x86_64-darwin":
      return "darwin-x64";
    case "x86_64-linux":
      return "linux-x64-baseline";
    default:
      throw new Error(`unsupported bun system: ${system}`);
  }
}

async function buildBun(context: ConfigContext): Promise<string> {
  const target = bunTarget(getSystemStr(context.getSystem()));
  const source = new ArtifactSource(
    "bun",
    `https://sdk.vorpal.build/source/bun-${bunVersion}-${target}.zip`,
  ).build();
  const script = `mkdir -p "$VORPAL_OUTPUT/bin"
cp -p "./source/bun/bun-${target}/bun" "$VORPAL_OUTPUT/bin/bun"
chmod +x "$VORPAL_OUTPUT/bin/bun"
`;
  const step = await shell(context, [], [], script, []);

  return new Artifact("bun", [step], SYSTEMS)
    .withAliases([`bun:${bunVersion}`])
    .withSources([source])
    .build(context);
}

async function main(): Promise<void> {
  const context = ConfigContext.create();

  const toolDigests: string[] = [];
  for (const alias of tools) {
    toolDigests.push(await context.fetchArtifactAlias(alias));
  }

  // The TypeScript development environment carries the SDK's bun.
  await new TypeScriptDevelopmentEnvironment(devEnvironment, SYSTEMS)
    .withArtifacts(toolDigests)
    .build(context);

  const bun = await buildBun(context);
  const step = await shell(context, [bun], [], buildScript, []);
  const source = new ArtifactSource(frontend, ".")
    .withExcludes(sourceExcludes)
    .withIncludes(sourceIncludes)
    .build();

  await new Artifact(frontend, [step], SYSTEMS)
    .withSources([source])
    .build(context);

  await context.run();
}

void main();
