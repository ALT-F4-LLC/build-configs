// This file was created once by `build-configs generate` from
// build-configs.yaml. You own it: edit it freely. Later runs do not
// overwrite it.

package main

import (
	"context"

	"github.com/ALT-F4-LLC/quirk-service-kit/config"
	"github.com/ALT-F4-LLC/quirk-service-kit/lambda"
	"github.com/ALT-F4-LLC/quirk-service-kit/telemetry"
	"github.com/ALT-F4-LLC/quirk-service-kit/aws"
	"github.com/aws/aws-lambda-go/events"
)

type Config struct {
	*config.BaseConfig
}

var cfg Config

func Handler(ctx context.Context, req events.APIGatewayV2HTTPRequest) (events.APIGatewayV2HTTPResponse, error) {
	// l := telemetry.GetLogger(ctx)
	// awsCfg := aws.GetConfig(ctx)
	// env := cfg.BaseConfig.Environment

	return lambda.NewOkResponse(), nil
}

func main() {
	if err := lambda.Start(Handler, &Config{}); err != nil {
		panic(err)
	}
}
-- out/cmd/vorpal/main.go --
// Code generated by build-configs. DO NOT EDIT.
// This file is generated by build-configs. Update it only through
// build-configs.yaml, then regenerate with `build-configs generate`.
// Do not edit it by hand. Listing a path in .bcignore opts that file
// out of generation.

package main

import (
	"log"

	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/artifact/language"
	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/config"
)

func main() {
	ctx := config.GetContext()

	var tools []*string
	for _, alias := range []string{
		"awscli2:2.33.1",
		"golangci-lint:2.11.4",
		"jq:1.8.1",
		"just:1.45.0",
	} {
		tool, err := ctx.FetchArtifactAlias(alias)
		if err != nil {
			log.Fatalf("failed fetching %s alias: %v", alias, err)
		}
		tools = append(tools, tool)
	}

	_, err := language.NewGoDevelopmentEnvironment("example-dev", config.SYSTEMS).
		WithArtifacts(tools).
		WithEnvironments([]string{"GOPRIVATE=github.com/example/private-kit"}).
		Build(ctx)
	if err != nil {
		log.Fatalf("failed building development environment: %v", err)
	}

	_, err = language.NewGo("api", config.SYSTEMS).
		WithBuildDirectory("cmd/api").
		WithBuildFlags("-ldflags='-s -w' -tags='lambda.norpc'").
		WithEnvironments([]string{"CGO_ENABLED=0"}).
		Build(ctx)
	if err != nil {
		log.Fatalf("failed building api: %v", err)
	}

	_, err = language.NewGo("worker", config.SYSTEMS).
		WithBuildDirectory("cmd/worker").
		WithBuildFlags("-ldflags='-s -w' -tags='lambda.norpc'").
		WithEnvironments([]string{"CGO_ENABLED=0"}).
		Build(ctx)
	if err != nil {
		log.Fatalf("failed building worker: %v", err)
	}

	if err := ctx.Run(); err != nil {
		log.Fatalf("failed running vorpal: %v", err)
	}
}
-- out/cmd/worker/main.go --
