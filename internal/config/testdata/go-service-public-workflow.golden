---
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

name: ci

on:
  push:
    branches: [main]
  pull_request:

jobs:
  check:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    permissions:
      contents: read
    runs-on: ubuntu-latest
    steps:
      - uses: ALT-F4-LLC/setup-vorpal-action@0.2.1
        with:
          registry-backend: s3
          registry-backend-s3-bucket: altf4llc-vorpal-registry
          version: 0.6.0
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_DEFAULT_REGION: ${{ vars.AWS_DEFAULT_REGION }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - run: just secret-scan
        shell: bash .github/vorpal-shell.sh {0}
      - run: just doc-validate
        shell: bash .github/vorpal-shell.sh {0}
      - id: generate-token
        uses: actions/create-github-app-token@v3
        with:
          client-id: ${{ vars.ALTF4LLC_GITHUB_APP_CLIENT_ID }}
          owner: ${{ github.repository_owner }}
          private-key: ${{ secrets.ALTF4LLC_GITHUB_APP_PRIVATE_KEY }}
      - uses: extractions/netrc@v3
        with:
          machine: github.com
          password: ${{ steps.generate-token.outputs.token }}
          username: ${{ secrets.ALTF4LLC_GITHUB_APP_USER }}
      - run: just lint
        shell: bash .github/vorpal-shell.sh {0}
      - run: just vuln-scan
        shell: bash .github/vorpal-shell.sh {0}
      - run: rm -f ~/.netrc
        if: always()

  build:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    needs:
      - check
    permissions:
      contents: read
    runs-on: ubuntu-latest
    steps:
      - uses: ALT-F4-LLC/setup-vorpal-action@0.2.1
        with:
          registry-backend: s3
          registry-backend-s3-bucket: altf4llc-vorpal-registry
          version: 0.6.0
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_DEFAULT_REGION: ${{ vars.AWS_DEFAULT_REGION }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
      - uses: actions/checkout@v7
      - id: generate-token
        uses: actions/create-github-app-token@v3
        with:
          client-id: ${{ vars.ALTF4LLC_GITHUB_APP_CLIENT_ID }}
          owner: ${{ github.repository_owner }}
          private-key: ${{ secrets.ALTF4LLC_GITHUB_APP_PRIVATE_KEY }}
      - uses: extractions/netrc@v3
        with:
          machine: github.com
          password: ${{ steps.generate-token.outputs.token }}
          username: ${{ secrets.ALTF4LLC_GITHUB_APP_USER }}
      - run: just package "demo"
        shell: bash .github/vorpal-shell.sh {0}
      - run: rm -f ~/.netrc
        if: always()
