-- out/.github/vorpal-shell.sh --
#!/usr/bin/env bash
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

# Step shell for CI: runs the step script ($1) inside the dev Vorpal
# environment. The activate script sets PATH, then runs its arguments.
set -euo pipefail

exec "$(vorpal build --path 'example-dev')/bin/activate" bash -e "$1"
-- out/.github/workflows/ci.yaml --
---
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

name: ci

on:
  push:
    branches: [main]
  pull_request:

jobs:
  check:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - run: just secret-scan
        shell: bash .github/vorpal-shell.sh {0}
      - run: just doc-validate
        shell: bash .github/vorpal-shell.sh {0}
      - id: generate-token
        uses: actions/create-github-app-token@v3
        with:
          app-id: ${{ secrets.ALTF4LLC_GITHUB_APP_ID }}
          owner: ${{ github.repository_owner }}
          private-key: ${{ secrets.ALTF4LLC_GITHUB_APP_PRIVATE_KEY }}
      - uses: extractions/netrc@v3
        with:
          machine: github.com
          password: ${{ steps.generate-token.outputs.token }}
          username: ${{ secrets.ALTF4LLC_GITHUB_APP_USER }}
      - run: just lint
        shell: bash .github/vorpal-shell.sh {0}
      - run: just vuln-scan
        shell: bash .github/vorpal-shell.sh {0}
      - run: rm -f ~/.netrc
        if: always()

  build:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    needs:
      - check
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
      - uses: actions/checkout@v7
      - id: generate-token
        uses: actions/create-github-app-token@v3
        with:
          app-id: ${{ secrets.ALTF4LLC_GITHUB_APP_ID }}
          owner: ${{ github.repository_owner }}
          private-key: ${{ secrets.ALTF4LLC_GITHUB_APP_PRIVATE_KEY }}
      - uses: extractions/netrc@v3
        with:
          machine: github.com
          password: ${{ steps.generate-token.outputs.token }}
          username: ${{ secrets.ALTF4LLC_GITHUB_APP_USER }}
      - run: just package "example"
        shell: bash .github/vorpal-shell.sh {0}
      - run: rm -f ~/.netrc
        if: always()
-- out/.golangci.yaml --
---
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

version: "2"

linters:
  default: standard
  enable:
    - gocritic
    - gosec
    - misspell
    - revive
  exclusions:
    presets:
      # Internal CLI packages, not a public API: skip missing doc-comment findings.
      - comments
    rules:
      - path: '(.+)\.go$'
        text: "Error return value of `\\(github.com/go-kit/log.Logger\\).Log` is not checked"
-- out/Vorpal.toml --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

language = "go"

[source]
includes = [
    "cmd/vorpal",
    "go.mod",
    "go.sum",
    "internal/vorpal"
]

[source.go]
directory = "cmd/vorpal"
-- out/cmd/vorpal/main.go --
// Code generated by build-configs. DO NOT EDIT.
// This file is generated by build-configs. Update it only through
// build-configs.yaml, then regenerate with `build-configs generate`.
// Do not edit it by hand. Listing a path in .bcignore opts that file
// out of generation.

package main

import (
	"log"
	"os"
	"path/filepath"
	"slices"
	"strings"

	api "github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/api/artifact"
	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/artifact"
	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/artifact/language"
	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/config"
)

// cgoDisabled builds every Go binary without cgo.
const cgoDisabled = "CGO_ENABLED=0"

// services are the Go binaries built from cmd/<name>.
var services = []string{
	"example",
}

func main() {
	ctx := config.GetContext()

	var tools []*string
	for _, alias := range []string{
		"golangci-lint:2.15.0",
		"govulncheck:1.9.0",
		"jq:1.8.1",
		"just:1.45.0",
		"gitleaks:8.30.1",
		"rumdl:0.3.2",
	} {
		tool, err := ctx.FetchArtifactAlias(alias)
		if err != nil {
			log.Fatalf("failed fetching %s alias: %v", alias, err)
		}
		tools = append(tools, tool)
	}

	_, err := language.NewGoDevelopmentEnvironment("example-dev", config.SYSTEMS).
		WithArtifacts(tools).
		WithEnvironments([]string{"GOPRIVATE=github.com/ALT-F4-LLC/quirk-service-kit"}).
		Build(ctx)
	if err != nil {
		log.Fatalf("failed building development environment: %v", err)
	}

	// The private module credential goes to the artifact being built and,
	// when that is the image, to the services the image builds.
	credentialed := []string{ctx.GetArtifactName()}
	sandbox := newPrivateModuleSandbox(ctx.GetTargetStr(), credentialed)

	for _, service := range services {
		builder := language.NewGo(service, config.SYSTEMS).
			WithBuildDirectory("cmd/" + service).
			WithBuildFlags("-ldflags='-s -w'").
			WithSource(source(service))
		builder = builder.
			WithEnvironments(sandbox.environments(service, cgoDisabled)).
			WithSecrets(sandbox.secretsFor(service))
		if script := sandbox.scriptFor(service); script != "" {
			builder = builder.WithSourceScript(script)
		}
		if _, err := builder.Build(ctx); err != nil {
			log.Fatalf("failed building %s: %v", service, err)
		}
	}

	if err := ctx.Run(); err != nil {
		log.Fatalf("failed running vorpal: %v", err)
	}
}

// source returns the source for the artifact called name: only the listed
// paths, since Vorpal ignores .gitignore and uploads the source to the
// registry, and never the dist directory, where `just build` and
// `just package-image` write, so their output never changes the artifact
// digest.
func source(name string) *api.ArtifactSource {
	src := artifact.NewArtifactSource(name, ".").
		WithExcludes([]string{
			"dist",
		}).
		WithIncludes([]string{
			"cmd",
			"internal",
			"pkg",
			"go.mod",
			"go.sum",
		}).
		Build()

	return &src
}

// privateModuleSandbox holds what a sandboxed build needs to fetch private Go
// modules over HTTPS: the system CA bundle for git, and the runner's github.com
// credential from ~/.netrc, written to a .netrc inside the sandbox. The
// credential goes only to the artifacts the invocation builds with it, because
// the Vorpal agent encrypts every secret in the config it runs, and a build of
// another artifact, such as the development environment, has no use for one.
type privateModuleSandbox struct {
	base         []string
	netrcEnv     []string
	credentialed []string
	script       string
	secrets      map[string]string
}

func newPrivateModuleSandbox(target string, credentialed []string) privateModuleSandbox {
	// The sandbox builds with GOPRIVATE so Go never asks the module proxy or
	// the checksum database about the private modules.
	s := privateModuleSandbox{
		base:         []string{"GOPRIVATE=github.com/ALT-F4-LLC/quirk-service-kit"},
		credentialed: credentialed,
		secrets:      map[string]string{},
	}

	linux := strings.HasSuffix(target, "-linux")

	// The sandbox ships git without a CA bundle, so point it at the system one.
	// Only Linux targets have that path.
	if linux {
		s.base = append(s.base,
			"GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt",
			"SSL_CERT_DIR=/etc/ssl/certs",
			"SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt",
		)
	}

	user, token := readNetrc("github.com")
	if user == "" || token == "" {
		return s
	}

	s.netrcEnv = []string{"HOME=$VORPAL_WORKSPACE"}

	// The worker writes each secret to its own file under $VORPAL_SECRET_DIR,
	// named after the secret, and refuses a step whose arguments or environment
	// reference a secret, so the script reads the files rather than variables.
	// $(<file) and printf are shell builtins, so no value appears in a
	// process's arguments, and a failed read stops the script before it writes
	// an empty credential.
	s.secrets["NETRC_USERNAME"] = user
	s.secrets["NETRC_PASSWORD"] = token

	// The subshell scopes umask 077 to the .netrc write, so the service
	// binary the build writes afterward keeps its usual mode.
	s.script = "(\n" +
		"umask 077\n" +
		"netrc_login=\"$(<\"$VORPAL_SECRET_DIR/NETRC_USERNAME\")\" || exit 1\n" +
		"netrc_password=\"$(<\"$VORPAL_SECRET_DIR/NETRC_PASSWORD\")\" || exit 1\n" +
		"printf 'machine github.com login %s password %s\\n' \"$netrc_login\" \"$netrc_password\" > \"$VORPAL_WORKSPACE/.netrc\" || exit 1\n" +
		"chmod 600 \"$VORPAL_WORKSPACE/.netrc\" || exit 1\n" +
		") || exit 1"

	return s
}

// environments returns the sandbox settings for the artifact called name,
// followed by extra, because WithEnvironments replaces the existing list
// rather than appending to it.
func (s privateModuleSandbox) environments(name string, extra ...string) []string {
	env := append([]string{}, s.base...)
	if slices.Contains(s.credentialed, name) {
		env = append(env, s.netrcEnv...)
	}

	return append(env, extra...)
}

// secretsFor returns the credential secrets for the artifact called name, or
// none when it is not built with the credential.
func (s privateModuleSandbox) secretsFor(name string) map[string]string {
	if !slices.Contains(s.credentialed, name) {
		return nil
	}

	return s.secrets
}

// scriptFor returns the script that writes the sandbox .netrc for the artifact
// called name, or an empty script when it is not built with the credential.
func (s privateModuleSandbox) scriptFor(name string) string {
	if !slices.Contains(s.credentialed, name) {
		return ""
	}

	return s.script
}

// readNetrc returns the login and password the runner's ~/.netrc holds for
// host, or empty strings when the file or the entry is absent.
func readNetrc(host string) (string, string) {
	home, err := os.UserHomeDir()
	if err != nil {
		return "", ""
	}

	data, err := os.ReadFile(filepath.Join(home, ".netrc"))
	if err != nil {
		return "", ""
	}

	var login, password string
	var inHost bool

	fields := strings.Fields(string(data))
	for i := 0; i+1 < len(fields); i += 2 {
		switch fields[i] {
		case "machine":
			if inHost {
				return login, password
			}
			inHost = fields[i+1] == host
		case "default":
			// A default entry takes no value and ends the host's entry.
			if inHost {
				return login, password
			}
			i--
		case "login":
			if inHost {
				login = fields[i+1]
			}
		case "password":
			if inHost {
				password = fields[i+1]
			}
		default:
			// Unknown or valueless keyword: realign on the next token.
			i--
		}
	}

	if !inHost {
		return "", ""
	}

	return login, password
}
-- out/justfile --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

build service:
    #!/usr/bin/env bash
    set -euxo pipefail
    mkdir -p 'dist/{{ service }}'
    CGO_ENABLED=0 go build \
        -ldflags='-s -w' \
        -o 'dist/{{ service }}/{{ service }}' \
        './cmd/{{ service }}'

check:
    golangci-lint run ./...

# lint runs the linter alone: CI runs it after the generators, with a private
# module token on disk, so it must not depend on them.
lint:
    golangci-lint run ./...

doc-validate:
    rumdl check --no-cache --deny-config-warnings .

install service:
    CGO_ENABLED=0 go install -ldflags='-s -w' './cmd/{{ service }}'

# package builds the Vorpal artifact called name: a service, or an entry of
# artifacts.
package name:
    vorpal build --path '{{ name }}'

package-all:
    just package "example"

secret-scan:
    gitleaks git --no-banner --redact --exit-code 1 --log-opts=HEAD .

test:
    go test -count=1 ./...

vuln-scan:
    govulncheck ./...
