-- out/.github/vorpal-shell.sh --
#!/usr/bin/env bash
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

# Step shell for CI: runs the step script ($1) inside the dev Vorpal
# environment. The activate script sets PATH, then runs its arguments.
set -euo pipefail

exec "$(vorpal build --path 'example-dev')/bin/activate" bash -e "$1"
-- out/.github/workflows/ci.yaml --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

name: ci

on:
  pull_request:
  push:
    branches:
      - main

jobs:
  check:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
      - uses: actions/checkout@v7
      - run: just check
        shell: bash .github/vorpal-shell.sh {0}

  build:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    needs:
      - check
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
      - uses: actions/checkout@v7
      - run: just build
        shell: bash .github/vorpal-shell.sh {0}
-- out/.golangci.yaml --
---
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

version: "2"

linters:
  default: standard
  enable:
    - gocritic
    - gosec
    - misspell
    - revive
  exclusions:
    presets:
      # Internal CLI packages, not a public API: skip missing doc-comment findings.
      - comments
-- out/Vorpal.toml --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

language = "go"

[source]
includes = [
    "cmd/vorpal",
    "go.mod",
    "go.sum",
]

[source.go]
directory = "cmd/vorpal"
-- out/cmd/vorpal/main.go --
// Code generated by build-configs. DO NOT EDIT.
// This file is generated by build-configs. Update it only through
// build-configs.yaml, then regenerate with `build-configs generate`.
// Do not edit it by hand. Listing a path in .bcignore opts that file
// out of generation.

package main

import (
	"log"

	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/artifact/language"
	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/config"
)

func main() {
	ctx := config.GetContext()

	var tools []*string
	for _, alias := range []string{
		"golangci-lint:2.11.4",
		"govulncheck:1.9.0",
		"gitleaks:8.30.1",
		"rumdl:0.3.2",
	} {
		tool, err := ctx.FetchArtifactAlias(alias)
		if err != nil {
			log.Fatalf("failed fetching %s alias: %v", alias, err)
		}
		tools = append(tools, tool)
	}

	_, err := language.NewGoDevelopmentEnvironment("example-dev", config.SYSTEMS).
		WithArtifacts(tools).
		Build(ctx)
	if err != nil {
		log.Fatalf("failed building development environment: %v", err)
	}

	_, err = language.NewGo("example", config.SYSTEMS).
		WithBuildDirectory("cmd/example").
		WithIncludes([]string{
			"cmd/example",
			"go.mod",
			"go.sum",
			"internal",
		}).
		Build(ctx)
	if err != nil {
		log.Fatalf("failed building: %v", err)
	}

	ctx.Run() //nolint:errcheck,gosec // keeps the current exit behavior; Run's error is not surfaced today
}
