// build-configs.yaml. You own it: edit it freely. Later runs do not
// overwrite it.

package main

import (
	"context"

	"github.com/ALT-F4-LLC/quirk-service-kit/config"
	"github.com/ALT-F4-LLC/quirk-service-kit/lambda"
	"github.com/ALT-F4-LLC/quirk-service-kit/telemetry"
	"github.com/ALT-F4-LLC/quirk-service-kit/aws"
	"github.com/aws/aws-lambda-go/events"
)

type Config struct {
	*config.BaseConfig
}

var cfg Config

func Handler(ctx context.Context, req events.APIGatewayV2HTTPRequest) (events.APIGatewayV2HTTPResponse, error) {
	// l := telemetry.GetLogger(ctx)
	// awsCfg := aws.GetConfig(ctx)
	// env := cfg.BaseConfig.Environment

	return lambda.NewOkResponse(), nil
}

func main() {
	if err := lambda.Start(Handler, &Config{}); err != nil {
		panic(err)
	}
}
-- out/cmd/vorpal/main.go --
// Code generated by build-configs. DO NOT EDIT.
// This file is generated by build-configs. Update it only through
// build-configs.yaml, then regenerate with `build-configs generate`.
// Do not edit it by hand. Listing a path in .bcignore opts that file
// out of generation.

package main

import (
	"log"
	"os"
	"path/filepath"
	"strings"

	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/artifact/language"
	"github.com/ALT-F4-LLC/vorpal/sdk/go/pkg/config"
)

func main() {
	ctx := config.GetContext()

	var tools []*string
	for _, alias := range []string{
		"awscli2:2.33.1",
		"golangci-lint:2.11.4",
		"jq:1.8.1",
		"just:1.45.0",
	} {
		tool, err := ctx.FetchArtifactAlias(alias)
		if err != nil {
			log.Fatalf("failed fetching %s alias: %v", alias, err)
		}
		tools = append(tools, tool)
	}

	_, err := language.NewGoDevelopmentEnvironment("example-dev", config.SYSTEMS).
		WithArtifacts(tools).
		WithEnvironments([]string{"GOPRIVATE=github.com/ALT-F4-LLC/quirk-service-kit"}).
		Build(ctx)
	if err != nil {
		log.Fatalf("failed building development environment: %v", err)
	}

	sandbox := newPrivateModuleSandbox(ctx.GetTargetStr(), ctx.GetArtifactName())

	_, err = language.NewGo("example", config.SYSTEMS).
		WithBuildDirectory("cmd/example").
		WithBuildFlags("-ldflags='-s -w' -tags='lambda.norpc'").
		WithEnvironments(sandbox.environments("example", "CGO_ENABLED=0")).
		WithSecrets(sandbox.secretsFor("example")).
		WithSourceScript(sandbox.scriptFor("example")).
		Build(ctx)
	if err != nil {
		log.Fatalf("failed building example: %v", err)
	}

	if err := ctx.Run(); err != nil {
		log.Fatalf("failed running vorpal: %v", err)
	}
}

// privateModuleSandbox holds what a sandboxed build needs to fetch private Go
// modules over HTTPS: the system CA bundle for git, and the runner's github.com
// credential from ~/.netrc, written to a .netrc inside the sandbox. The
// credential goes only to the artifact the invocation builds, because the
// Vorpal agent encrypts every secret in the config it runs, and a build of
// another artifact, such as the development environment, has no use for one.
type privateModuleSandbox struct {
	base      []string
	netrcEnv  []string
	requested string
	script    string
	secrets   map[string]string
}

func newPrivateModuleSandbox(target, requested string) privateModuleSandbox {
	// The sandbox builds with GOPRIVATE so Go never asks the module proxy or
	// the checksum database about the private modules.
	s := privateModuleSandbox{
		base:      []string{"GOPRIVATE=github.com/ALT-F4-LLC/quirk-service-kit"},
		requested: requested,
		secrets:   map[string]string{},
	}

	linux := strings.HasSuffix(target, "-linux")

	// The sandbox ships git without a CA bundle, so point it at the system one.
	// Only Linux targets have that path.
	if linux {
		s.base = append(s.base,
			"GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt",
			"SSL_CERT_DIR=/etc/ssl/certs",
			"SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt",
		)
	}

	login, password := readNetrc("github.com")
	if login == "" || password == "" {
		return s
	}

	s.netrcEnv = []string{"HOME=$VORPAL_WORKSPACE"}

	// A Linux sandbox clears its environment, so the secrets are passed through
	// by name. Elsewhere the secrets are already in the environment, and a
	// passthrough line could shadow a short login.
	if linux {
		s.netrcEnv = append(s.netrcEnv,
			"NETRC_PASSWORD=$NETRC_PASSWORD",
			"NETRC_USERNAME=$NETRC_USERNAME",
		)
	}

	s.script = `umask 077
printf 'machine github.com login %s password %s\n' "$NETRC_USERNAME" "$NETRC_PASSWORD" > "$VORPAL_WORKSPACE/.netrc"
chmod 600 "$VORPAL_WORKSPACE/.netrc"`
	s.secrets["NETRC_USERNAME"] = login
	s.secrets["NETRC_PASSWORD"] = password

	return s
}

// environments returns the sandbox settings for the artifact called name,
// followed by extra, because WithEnvironments replaces the existing list
// rather than appending to it.
func (s privateModuleSandbox) environments(name string, extra ...string) []string {
	env := append([]string{}, s.base...)
	if name == s.requested {
		env = append(env, s.netrcEnv...)
	}

	return append(env, extra...)
}

// secretsFor returns the credential secrets for the artifact called name, or
// none when another artifact is the one being built.
func (s privateModuleSandbox) secretsFor(name string) map[string]string {
	if name != s.requested {
		return nil
	}

	return s.secrets
}

// scriptFor returns the script that writes the sandbox .netrc for the artifact
// called name, or an empty script when another artifact is the one being built.
func (s privateModuleSandbox) scriptFor(name string) string {
	if name != s.requested {
		return ""
	}

	return s.script
}

// readNetrc returns the login and password the runner's ~/.netrc holds for
// host, or empty strings when the file or the entry is absent.
func readNetrc(host string) (string, string) {
	home, err := os.UserHomeDir()
	if err != nil {
		return "", ""
	}

	data, err := os.ReadFile(filepath.Join(home, ".netrc"))
	if err != nil {
		return "", ""
	}

	var login, password string
	var inHost bool

	fields := strings.Fields(string(data))
	for i := 0; i+1 < len(fields); i += 2 {
		switch fields[i] {
		case "machine":
			if inHost {
				return login, password
			}
			inHost = fields[i+1] == host
		case "default":
			// A default entry takes no value and ends the host's entry.
			if inHost {
				return login, password
			}
			i--
		case "login":
			if inHost {
				login = fields[i+1]
			}
		case "password":
			if inHost {
				password = fields[i+1]
			}
		default:
			// Unknown or valueless keyword: realign on the next token.
			i--
		}
	}

	if !inHost {
		return "", ""
	}

	return login, password
}
-- out/justfile --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

build profile:
    vorpal build '{{ profile }}'

check:
    golangci-lint run ./...

# lint runs the linter alone: CI runs it after the generators, with a private
# module token on disk, so it must not depend on them.
lint:
    golangci-lint run ./...

package profile:
    #!/usr/bin/env bash
    set -euxo pipefail
    OUTPUT=$(vorpal build --path '{{ profile }}')
    mkdir -p dist/{{ profile }}
    install -m 0755 "$OUTPUT/bin/{{ profile }}" dist/{{ profile }}/bootstrap
    rm -f dist/{{ profile }}/lambda.zip
    (cd dist/{{ profile }} && zip lambda.zip bootstrap)

package-all:
    just package "example"

package-native lambda:
    #!/usr/bin/env bash
    set -euxo pipefail
    mkdir -p dist/{{ lambda }}
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
        go build \
            -ldflags="-s -w" \
            -o dist/{{ lambda }}/bootstrap \
            -tags lambda.norpc \
            ./cmd/{{ lambda }}
    (cd dist/{{ lambda }} && zip lambda.zip bootstrap)

package-native-all:
    just package-native "example"

deploy environment lambda:
    aws lambda update-function-code \
        --function-name "quirk-{{ environment }}-example-{{ lambda }}" \
        --output json \
        --zip-file "fileb://dist/{{ lambda }}/lambda.zip" \
        | jq ".CodeSha256"

deploy-all environment:
    just deploy "{{ environment }}" "example"


