#!/usr/bin/env bash
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

# Step shell for CI: runs the step script ($1) inside the dev Vorpal
# environment. The activate script sets PATH, then runs its arguments.
set -euo pipefail

exec "$(vorpal build --path 'example-dev')/bin/activate" bash -e "$1"
-- out/.github/workflows/ci.yaml --
---
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

name: ci

on:
  push:
    branches: [main]
  pull_request:

jobs:
  check:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
      - uses: actions/checkout@v7
      - id: generate-token
        uses: actions/create-github-app-token@v3
        with:
          app-id: ${{ secrets.ALTF4LLC_GITHUB_APP_ID }}
          owner: ${{ github.repository_owner }}
          private-key: ${{ secrets.ALTF4LLC_GITHUB_APP_PRIVATE_KEY }}
      - uses: extractions/netrc@v3
        with:
          machine: github.com
          password: ${{ steps.generate-token.outputs.token }}
          username: ${{ secrets.ALTF4LLC_GITHUB_APP_USER }}
      - run: just lint
        shell: bash .github/vorpal-shell.sh {0}
      - run: rm -f ~/.netrc
        if: always()

  build:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    needs:
      - check
    permissions:
      contents: read
    runs-on: altf4llc
    strategy:
      matrix:
        profile:
          - example
    steps:
      - uses: actions/checkout@v7
      - id: generate-token
        uses: actions/create-github-app-token@v3
        with:
          app-id: ${{ secrets.ALTF4LLC_GITHUB_APP_ID }}
          owner: ${{ github.repository_owner }}
          private-key: ${{ secrets.ALTF4LLC_GITHUB_APP_PRIVATE_KEY }}
      - uses: extractions/netrc@v3
        with:
          machine: github.com
          password: ${{ steps.generate-token.outputs.token }}
          username: ${{ secrets.ALTF4LLC_GITHUB_APP_USER }}
      - run: cp --no-preserve=mode ~/.netrc /tmp/.netrc
      - run: just build "${{ matrix.profile }}"
        shell: bash .github/vorpal-shell.sh {0}
      - run: just package "${{ matrix.profile }}"
        shell: bash .github/vorpal-shell.sh {0}
      - uses: actions/upload-artifact@v7
        with:
          name: "zip-${{ matrix.profile }}"
          path: "dist/${{ matrix.profile }}/lambda.zip"
          if-no-files-found: error
          retention-days: 7
      - run: rm -f /tmp/.netrc
        if: always()
      - run: rm -f ~/.netrc
        if: always()
  
-- out/.golangci.yaml --
---
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

version: "2"

linters:
  default: standard
  enable:
    - gocritic
    - gosec
    - misspell
    - revive
  exclusions:
    presets:
      # Internal CLI packages, not a public API: skip missing doc-comment findings.
      - comments
    rules:
      - path: '(.+)\.go$'
        text: "Error return value of `\\(github.com/go-kit/log.Logger\\).Log` is not checked"
