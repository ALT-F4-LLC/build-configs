-- out/.envrc --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

use_vorpal() {
    source "$(vorpal build --path 'terraform-quirk-apigateway-dev')/bin/activate"
}

use vorpal
-- out/.github/renovate.json --
{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": [
        "This file is generated by build-configs. Update it only through build-configs.yaml, then regenerate with `build-configs generate`. Do not edit it by hand. Listing a path in .bcignore opts that file out of generation."
    ],
    "extends": [
        "config:base",
        ":semanticCommitTypeAll(chore)"
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "extends": [
            "schedule:weekly"
        ]
    }
}
-- out/.github/vorpal-shell.sh --
#!/usr/bin/env bash
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

# Step shell for CI: runs the step script ($1) inside the dev Vorpal
# environment. The activate script sets PATH, then runs its arguments.
set -euo pipefail

exec "$(vorpal build --path 'terraform-quirk-apigateway-dev')/bin/activate" bash -e "$1"
-- out/.github/workflows/terraform.yaml --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

name: terraform

on:
  pull_request:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  check:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
    - uses: actions/checkout@v7
      with:
        fetch-depth: 0
        persist-credentials: false
    - run: just secret-scan
      shell: bash .github/vorpal-shell.sh {0}
    - run: just check
      shell: bash .github/vorpal-shell.sh {0}

  plan:
    concurrency:
      cancel-in-progress: false
      group: tf-lock
    env:
      TF_VAR_PLATFORM_DIRECTORY_TOKEN: ${{ secrets.TF_VAR_PLATFORM_DIRECTORY_TOKEN }}
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    needs:
    - check
    permissions:
      contents: read
      id-token: write
    runs-on: altf4llc
    steps:
    - id: deploy-key
      uses: shimataro/ssh-key-action@v2
      with:
        key: ${{ secrets.ALTF4LLC_DEPLOY_KEY }}
        known_hosts: unnecessary
        name: id_rsa
    - uses: aws-actions/configure-aws-credentials@v6
      with:
        audience: sts.amazonaws.com
        aws-region: us-west-2
        role-to-assume: arn:aws:iam::677459762413:role/altf4llc-gha-terraform-quirk-apigateway-plan
    - uses: actions/checkout@v7
      with:
        persist-credentials: false
    - run: aws sts get-caller-identity
      shell: bash .github/vorpal-shell.sh {0}
    - run: just init
      shell: bash .github/vorpal-shell.sh {0}
    - run: just validate
      shell: bash .github/vorpal-shell.sh {0}
    - run: just plan
      shell: bash .github/vorpal-shell.sh {0}
    - uses: actions/upload-artifact@v7
      with:
        name: tf-plan
        path: terraform.tfplan
    - env:
        KEY_OUTCOME: ${{ steps.deploy-key.outcome }}
      if: always()
      run: if [ "$KEY_OUTCOME" = success ]; then rm -f "$HOME/.ssh/id_rsa"; fi
      shell: bash

  apply:
    concurrency:
      cancel-in-progress: false
      group: tf-lock
    environment:
      name: prod
    env:
      TF_VAR_PLATFORM_DIRECTORY_TOKEN: ${{ secrets.TF_VAR_PLATFORM_DIRECTORY_TOKEN }}
    if: ${{ (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) && (github.ref == 'refs/heads/main') }}
    needs: plan
    permissions:
      contents: read
      id-token: write
    runs-on: altf4llc
    steps:
    - id: deploy-key
      uses: shimataro/ssh-key-action@v2
      with:
        key: ${{ secrets.ALTF4LLC_DEPLOY_KEY }}
        known_hosts: unnecessary
        name: id_rsa
    - uses: aws-actions/configure-aws-credentials@v6
      with:
        audience: sts.amazonaws.com
        aws-region: us-west-2
        role-to-assume: arn:aws:iam::677459762413:role/altf4llc-gha-terraform-quirk-apigateway-apply
    - uses: actions/checkout@v7
      with:
        persist-credentials: false
    - uses: actions/download-artifact@v8
      with:
        name: tf-plan
    - run: aws sts get-caller-identity
      shell: bash .github/vorpal-shell.sh {0}
    - run: just init
      shell: bash .github/vorpal-shell.sh {0}
    - run: just apply
      shell: bash .github/vorpal-shell.sh {0}
    - env:
        KEY_OUTCOME: ${{ steps.deploy-key.outcome }}
      if: always()
      run: if [ "$KEY_OUTCOME" = success ]; then rm -f "$HOME/.ssh/id_rsa"; fi
      shell: bash
-- out/.gitignore --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

.direnv
*.tfplan

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc
.terraform.lock.hcl

# Bun dependencies for the Vorpal config program
node_modules
-- out/Vorpal.toml --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

language = "typescript"

[source]
includes = [
    "bun.lock",
    "bunfig.toml",
    "package.json",
    "src/vorpal.ts",
    "tsconfig.json"
]

[source.typescript]
entrypoint = "src/vorpal.ts"
