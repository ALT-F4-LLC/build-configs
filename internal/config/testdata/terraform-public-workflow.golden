# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

name: terraform

on:
  pull_request:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  check:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    permissions:
      contents: read
    runs-on: ubuntu-latest
    steps:
    - uses: ALT-F4-LLC/setup-vorpal-action@0.2.1
      with:
        registry-backend: s3
        registry-backend-s3-bucket: altf4llc-vorpal-registry
        version: 0.6.0
      env:
        AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
        AWS_DEFAULT_REGION: ${{ vars.AWS_DEFAULT_REGION }}
        AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
    - uses: actions/checkout@v7
      with:
        fetch-depth: 0
        persist-credentials: false
    - run: just secret-scan
      shell: bash .github/vorpal-shell.sh {0}
    - run: just check
      shell: bash .github/vorpal-shell.sh {0}

  plan:
    concurrency:
      cancel-in-progress: false
      group: ${{ github.event_name == 'pull_request' && format('tf-plan-{0}', github.event.pull_request.number) || 'tf-lock' }}
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    needs:
    - check
    permissions:
      contents: read
      id-token: write
      pull-requests: write
    runs-on: ubuntu-latest
    steps:
    - uses: ALT-F4-LLC/setup-vorpal-action@0.2.1
      with:
        registry-backend: s3
        registry-backend-s3-bucket: altf4llc-vorpal-registry
        version: 0.6.0
      env:
        AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
        AWS_DEFAULT_REGION: ${{ vars.AWS_DEFAULT_REGION }}
        AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
    - uses: aws-actions/configure-aws-credentials@v6
      with:
        audience: sts.amazonaws.com
        aws-region: us-west-2
        role-to-assume: arn:aws:iam::677459762413:role/altf4llc-gha-demo-plan
    - uses: actions/checkout@v7
      with:
        persist-credentials: false
    - run: aws sts get-caller-identity
      shell: bash .github/vorpal-shell.sh {0}
    - run: just init
      shell: bash .github/vorpal-shell.sh {0}
    - run: just validate
      shell: bash .github/vorpal-shell.sh {0}
    # Pull request plans skip the state lock, so they never queue behind
    # another plan or an apply. Pushes and manual runs keep it.
    - run: just plan ${{ github.event_name == 'pull_request' && '-lock=false' || '' }}
      shell: bash .github/vorpal-shell.sh {0}
    - if: github.event_name == 'pull_request'
      name: Render plan summary
      run: |
        terraform show -no-color terraform.tfplan > terraform-plan.txt
        {
          echo '## Terraform Plan Summary'
          echo
          terraform show -json terraform.tfplan | jq -r '
            def action:
              (.change.actions) as $a
              | if ($a | index("delete")) and ($a | index("create")) then "Replace"
                elif ($a | index("create")) then "Create"
                elif ($a | index("delete")) then "Destroy"
                elif ($a | index("update")) then "Update"
                else empty end;
            [.resource_changes[]? | {address: .address, action: action}] as $changes
            | if ($changes | length) == 0 then "No resource changes."
              else
                "| Action | Resource |",
                "| --- | --- |",
                ($changes[] | "| \(.action) | `\(.address)` |"),
                "",
                (["Create", "Update", "Replace", "Destroy"][] as $kind
                  | "- \($kind): \([$changes[] | select(.action == $kind)] | length)")
              end'
        } > plan-summary.md
        echo "::group::Terraform plan"
        cat terraform-plan.txt
        echo "::endgroup::"
      shell: bash .github/vorpal-shell.sh {0}
    - if: github.event_name == 'pull_request'
      name: Comment plan on pull request
      uses: actions/github-script@v9
      with:
        script: |
          const fs = require('fs');
          // GitHub rejects comment bodies over 65536 characters.
          const limit = 60000;
          const fence = '`'.repeat(3);
          // A summary of thousands of resources must leave room for the plan.
          const summaryLimit = 20000;
          let summary = fs.readFileSync('plan-summary.md', 'utf8');
          if (summary.length > summaryLimit) {
            summary = summary.slice(0, summaryLimit) + '\n\n... summary truncated; see the full plan below or in the workflow logs.\n';
          }
          let plan = fs.readFileSync('terraform-plan.txt', 'utf8');
          const wrap = (text) =>
            `${summary}\n<details>\n<summary>Full plan output</summary>\n\n${fence}hcl\n${text}\n${fence}\n</details>`;
          let body = wrap(plan);
          if (body.length > limit) {
            const note = '\n... plan truncated; the full plan is in the workflow logs.';
            plan = plan.slice(0, Math.max(0, limit - (wrap(note).length))) + note;
            body = wrap(plan);
          }
          const { owner, repo } = context.repo;
          const issue_number = context.issue.number;
          const comments = await github.paginate(github.rest.issues.listComments, {
            owner,
            repo,
            issue_number,
          });
          const existing = comments.find((comment) =>
            comment.user.type === 'Bot' && comment.body.includes('Terraform Plan Summary'));
          if (existing) {
            await github.rest.issues.updateComment({ owner, repo, comment_id: existing.id, body });
          } else {
            await github.rest.issues.createComment({ owner, repo, issue_number, body });
          }
    - uses: actions/upload-artifact@v7
      with:
        name: tf-plan
        path: terraform.tfplan

  apply:
    concurrency:
      cancel-in-progress: false
      group: tf-lock
    environment:
      name: prod
    if: ${{ (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) && (github.ref == 'refs/heads/main') }}
    needs: plan
    permissions:
      contents: read
      id-token: write
    runs-on: ubuntu-latest
    steps:
    - uses: ALT-F4-LLC/setup-vorpal-action@0.2.1
      with:
        registry-backend: s3
        registry-backend-s3-bucket: altf4llc-vorpal-registry
        version: 0.6.0
      env:
        AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
        AWS_DEFAULT_REGION: ${{ vars.AWS_DEFAULT_REGION }}
        AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
    - uses: aws-actions/configure-aws-credentials@v6
      with:
        audience: sts.amazonaws.com
        aws-region: us-west-2
        role-to-assume: arn:aws:iam::677459762413:role/altf4llc-gha-demo-apply
    - uses: actions/checkout@v7
      with:
        persist-credentials: false
    - uses: actions/download-artifact@v8
      with:
        name: tf-plan
    - run: aws sts get-caller-identity
      shell: bash .github/vorpal-shell.sh {0}
    - run: just init
      shell: bash .github/vorpal-shell.sh {0}
    - run: just apply
      shell: bash .github/vorpal-shell.sh {0}
