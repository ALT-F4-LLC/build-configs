-- out/.github/vorpal-shell.sh --
#!/usr/bin/env bash
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

# Step shell for CI: runs the step script ($1) inside the dev Vorpal
# environment. The activate script sets PATH, then runs its arguments.
set -euo pipefail

exec "$(vorpal build --path 'example-dev')/bin/activate" bash -e "$1"
-- out/.github/workflows/terraform.yaml --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

name: terraform

on:
  pull_request:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  check:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    permissions:
      contents: read
    runs-on: altf4llc
    steps:
    - uses: actions/checkout@v7
      with:
        fetch-depth: 0
        persist-credentials: false
    - run: just secret-scan
      shell: bash .github/vorpal-shell.sh {0}
    - run: just check
      shell: bash .github/vorpal-shell.sh {0}

  plan:
    concurrency:
      cancel-in-progress: false
      group: tf-lock
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    needs:
    - check
    permissions:
      contents: read
      id-token: write
    runs-on: altf4llc
    steps:
    - uses: aws-actions/configure-aws-credentials@v6
      with:
        audience: sts.amazonaws.com
        aws-region: us-west-2
        role-to-assume: arn:aws:iam::677459762413:role/altf4llc-gha-example-plan
    - uses: actions/checkout@v7
      with:
        persist-credentials: false
    - run: aws sts get-caller-identity
      shell: bash .github/vorpal-shell.sh {0}
    - run: just init
      shell: bash .github/vorpal-shell.sh {0}
    - run: just validate
      shell: bash .github/vorpal-shell.sh {0}
    - run: just plan
      shell: bash .github/vorpal-shell.sh {0}
    - uses: actions/upload-artifact@v7
      with:
        name: tf-plan
        path: terraform.tfplan

  apply:
    concurrency:
      cancel-in-progress: false
      group: tf-lock
    environment:
      name: prod
    if: ${{ (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) && (github.ref == 'refs/heads/main') }}
    needs: plan
    permissions:
      contents: read
      id-token: write
    runs-on: altf4llc
    steps:
    - uses: aws-actions/configure-aws-credentials@v6
      with:
        audience: sts.amazonaws.com
        aws-region: us-west-2
        role-to-assume: arn:aws:iam::677459762413:role/altf4llc-gha-example-apply
    - uses: actions/checkout@v7
      with:
        persist-credentials: false
    - uses: actions/download-artifact@v8
      with:
        name: tf-plan
    - run: aws sts get-caller-identity
      shell: bash .github/vorpal-shell.sh {0}
    - run: just init
      shell: bash .github/vorpal-shell.sh {0}
    - run: just apply
      shell: bash .github/vorpal-shell.sh {0}
-- out/.gitignore --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

.direnv
*.tfplan

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc
.terraform.lock.hcl

# Bun dependencies for the Vorpal config program
node_modules
-- out/Vorpal.toml --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

language = "typescript"

[source]
includes = [
    "bun.lock",
    "bunfig.toml",
    "package.json",
    "src/vorpal.ts",
    "tsconfig.json"
]

[source.typescript]
entrypoint = "src/vorpal.ts"
-- out/justfile --
# This file is generated by build-configs. Update it only through
# build-configs.yaml, then regenerate with `build-configs generate`.
# Do not edit it by hand. Listing a path in .bcignore opts that file
# out of generation.

build:
    terraform init -backend=false
    terraform validate

check:
    terraform fmt -check

docs:
    terraform-docs markdown table \
        --output-file README.md \
        --output-mode inject .

format:
    terraform fmt -recursive

init:
    terraform init

secret-scan:
    gitleaks git --no-banner --redact --exit-code 1 --log-opts=HEAD .

validate:
    terraform validate

package:
    vorpal build --path 'example-dev'

plan:
    terraform plan -out "terraform.tfplan"

apply:
    terraform apply "terraform.tfplan"
-- out/src/vorpal.ts --
// This file is generated by build-configs. Update it only through
// build-configs.yaml, then regenerate with `build-configs generate`.
// Do not edit it by hand. Listing a path in .bcignore opts that file
// out of generation.

import {
  ConfigContext,
  SYSTEMS,
  TypeScriptDevelopmentEnvironment,
} from "@altf4llc/vorpal-sdk";

// devEnvironment is the development environment the dev shell and CI load.
const devEnvironment = "example-dev";

// tools are the Vorpal aliases the development environment adds to bun.
const tools: string[] = [
  "awscli2:2.33.1",
  "gitleaks:8.30.1",
  "jq:1.8.1",
  "just:1.45.0",
  "rumdl:0.3.2",
  "terraform:1.13.1",
];

async function main(): Promise<void> {
  const context = ConfigContext.create();

  const toolDigests: string[] = [];
  for (const alias of tools) {
    toolDigests.push(await context.fetchArtifactAlias(alias));
  }

  // The TypeScript development environment carries the SDK's bun.
  await new TypeScriptDevelopmentEnvironment(devEnvironment, SYSTEMS)
    .withArtifacts(toolDigests)
    .build(context);

  await context.run();
}

void main();
