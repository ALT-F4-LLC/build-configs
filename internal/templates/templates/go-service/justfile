# package-image builds the OCI image on a Linux host and copies its tarball
# to dist/, where push loads it.
package-image:
    #!/usr/bin/env bash
    set -euxo pipefail
    OUTPUT=$(vorpal build --path '{{ .ImageArtifact }}')
    mkdir -p 'dist/{{ .ImageArtifact }}'
    install -m 0644 "$OUTPUT/image.tar" 'dist/{{ .ImageArtifact }}/image.tar'

# push loads the image package-image wrote and pushes it to
# <registry>/{{ .Image.Repository }}:<tag>. Log in to the registry first. It
# removes both tags from the local daemon on exit, so a persistent runner keeps
# no image.
push registry tag=`git rev-parse HEAD`:
    #!/usr/bin/env bash
    set -euxo pipefail
    cleanup() { docker image rm --force '{{ .ImageArtifact }}:latest' '{{"{{"}} registry {{"}}"}}/{{ .Image.Repository }}:{{"{{"}} tag {{"}}"}}' >/dev/null 2>&1 || true; }
    trap cleanup EXIT
    docker image load --input 'dist/{{ .ImageArtifact }}/image.tar'
    docker image tag '{{ .ImageArtifact }}:latest' '{{"{{"}} registry {{"}}"}}/{{ .Image.Repository }}:{{"{{"}} tag {{"}}"}}'
    docker image push '{{"{{"}} registry {{"}}"}}/{{ .Image.Repository }}:{{"{{"}} tag {{"}}"}}'
{{- end }}
