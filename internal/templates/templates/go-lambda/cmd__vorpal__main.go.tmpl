// privateModuleSandbox holds what a sandboxed build needs to fetch private Go
// modules over HTTPS: the system CA bundle for git, and the runner's github.com
// credential from ~/.netrc, written to a .netrc inside the sandbox. The
// credential goes only to the artifact the invocation builds, because the
// Vorpal agent encrypts every secret in the config it runs, and a build of
// another artifact, such as the development environment, has no use for one.
type privateModuleSandbox struct {
	base      []string
	netrcEnv  []string
	requested string
	script    string
	secrets   map[string]string
}

func newPrivateModuleSandbox(target, requested string) privateModuleSandbox {
	// The sandbox builds with GOPRIVATE so Go never asks the module proxy or
	// the checksum database about the private modules.
	s := privateModuleSandbox{
		base:      []string{"GOPRIVATE={{ .PrivateModules }}"},
		requested: requested,
		secrets:   map[string]string{},
	}

	linux := strings.HasSuffix(target, "-linux")

	// The sandbox ships git without a CA bundle, so point it at the system one.
	// Only Linux targets have that path.
	if linux {
		s.base = append(s.base,
			"GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt",
			"SSL_CERT_DIR=/etc/ssl/certs",
			"SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt",
		)
	}

	user, token := readNetrc("github.com")
	if user == "" || token == "" {
		return s
	}

	s.netrcEnv = []string{"HOME=$VORPAL_WORKSPACE"}

	// The agent encrypts each secret with RSA PKCS#1 v1.5, which cannot take a
	// value over 245 bytes for the 2048-bit key Vorpal generates. A GitHub App
	// token can be long, so each credential travels as several short secrets
	// that the script joins again. A Linux sandbox clears its environment, so
	// the secrets are passed through by name. Elsewhere they are already in the
	// environment, and a passthrough line could shadow a short value.
	var login, password strings.Builder
	for _, credential := range []struct {
		name  string
		value string
		ref   *strings.Builder
	}{
		{"NETRC_USERNAME", user, &login},
		{"NETRC_PASSWORD", token, &password},
	} {
		for i, part := range splitSecret(credential.value) {
			key := fmt.Sprintf("%s_%d", credential.name, i)
			s.secrets[key] = part
			credential.ref.WriteString("${" + key + "}")

			if linux {
				s.netrcEnv = append(s.netrcEnv, key+"=$"+key)
			}
		}
	}

	s.script = "umask 077\n" +
		"printf 'machine github.com login %s password %s\\n' \"" + login.String() + "\" \"" + password.String() + "\" > \"$VORPAL_WORKSPACE/.netrc\"\n" +
		"chmod 600 \"$VORPAL_WORKSPACE/.netrc\""

	return s
}

// environments returns the sandbox settings for the artifact called name,
// followed by extra, because WithEnvironments replaces the existing list
// rather than appending to it.
func (s privateModuleSandbox) environments(name string, extra ...string) []string {
	env := append([]string{}, s.base...)
	if name == s.requested {
		env = append(env, s.netrcEnv...)
	}

	return append(env, extra...)
}

// secretsFor returns the credential secrets for the artifact called name, or
// none when another artifact is the one being built.
func (s privateModuleSandbox) secretsFor(name string) map[string]string {
	if name != s.requested {
		return nil
	}

	return s.secrets
}

// scriptFor returns the script that writes the sandbox .netrc for the artifact
// called name, or an empty script when another artifact is the one being built.
func (s privateModuleSandbox) scriptFor(name string) string {
	if name != s.requested {
		return ""
	}

	return s.script
}

// secretChunk is the longest value passed as one Vorpal secret.
const secretChunk = 200

// splitSecret cuts value into parts of at most secretChunk bytes, and returns
// one empty part for an empty value.
func splitSecret(value string) []string {
	var parts []string
	for len(value) > secretChunk {
		parts = append(parts, value[:secretChunk])
		value = value[secretChunk:]
	}

	return append(parts, value)
}

// readNetrc returns the login and password the runner's ~/.netrc holds for
// host, or empty strings when the file or the entry is absent.
func readNetrc(host string) (string, string) {
	home, err := os.UserHomeDir()
	if err != nil {
		return "", ""
	}

	data, err := os.ReadFile(filepath.Join(home, ".netrc"))
	if err != nil {
		return "", ""
	}

	var login, password string
	var inHost bool

	fields := strings.Fields(string(data))
	for i := 0; i+1 < len(fields); i += 2 {
		switch fields[i] {
		case "machine":
			if inHost {
				return login, password
			}
			inHost = fields[i+1] == host
		case "default":
			// A default entry takes no value and ends the host's entry.
			if inHost {
				return login, password
			}
			i--
		case "login":
			if inHost {
				login = fields[i+1]
			}
		case "password":
			if inHost {
				password = fields[i+1]
			}
		default:
			// Unknown or valueless keyword: realign on the next token.
			i--
		}
	}

	if !inHost {
		return "", ""
	}

	return login, password
}
