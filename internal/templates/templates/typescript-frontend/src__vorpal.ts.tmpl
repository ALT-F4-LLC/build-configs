// This file is generated by build-configs. Update it only through
// build-configs.yaml, then regenerate with `build-configs generate`.
// Do not edit it by hand. Listing a path in .bcignore opts that file
// out of generation.

import {
  Artifact,
  ArtifactSource,
  ConfigContext,
  SYSTEMS,
  TypeScriptDevelopmentEnvironment,
  getSystemStr,
  shell,
} from "@altf4llc/vorpal-sdk";

// frontend is the Vorpal artifact holding the static build output.
const frontend = {{ .JSString .Name }};

// devEnvironment is the development environment the dev shell and CI load.
const devEnvironment = {{ .JSString .DevEnvironment }};

// tools are the Vorpal aliases the development environment adds to bun.
const tools: string[] = [
{{- range .DevTools }}
  {{ $.JSString . }},
{{- end }}
];

// sourceExcludes and sourceIncludes bound the frontend source: only the
// listed paths, since Vorpal ignores .gitignore and uploads the source to the
// registry, and never the build output, node_modules or this program, so a
// local build, an install or a config change never changes the digest.
const sourceExcludes: string[] = [
{{- range .SourceExcludes }}
  {{ $.JSString . }},
{{- end }}
];

const sourceIncludes: string[] = [
{{- range .SourceIncludes }}
  {{ $.JSString . }},
{{- end }}
];

// buildScript installs the locked dependencies, runs the package.json build
// script under the bun runtime, since the sandbox has no node, and copies its
// output directory into the artifact.
const buildScript = [
  "set -euo pipefail",
  {{ .JSString (printf "pushd \"./source/%s\"" .Name) }},
  "bun install --frozen-lockfile",
  {{ .JSString (printf "bun --bun run %s" .Scripts.Build) }},
  {{ .JSString (printf "test -d \"%s\"" .Output) }},
  "mkdir -p \"$VORPAL_OUTPUT\"",
  {{ .JSString (printf "cp -R \"%s/.\" \"$VORPAL_OUTPUT/\"" .Output) }},
  "popd",
].join("\n");

// bunVersion and buildBun copy the SDK's Bun builder, which
// @altf4llc/vorpal-sdk 0.6.0 does not export. The inputs match it, so this
// is the bun the development environment already carries.
const bunVersion = "1.4.4";

function bunTarget(system: string): string {
  switch (system) {
    case "aarch64-darwin":
      return "darwin-aarch64";
    case "aarch64-linux":
      return "linux-aarch64";
    case "x86_64-darwin":
      return "darwin-x64";
    case "x86_64-linux":
      return "linux-x64-baseline";
    default:
      throw new Error(`unsupported bun system: ${system}`);
  }
}

async function buildBun(context: ConfigContext): Promise<string> {
  const target = bunTarget(getSystemStr(context.getSystem()));
  const source = new ArtifactSource(
    "bun",
    `https://sdk.vorpal.build/source/bun-${bunVersion}-${target}.zip`,
  ).build();
  const script = `mkdir -p "$VORPAL_OUTPUT/bin"
cp -p "./source/bun/bun-${target}/bun" "$VORPAL_OUTPUT/bin/bun"
chmod +x "$VORPAL_OUTPUT/bin/bun"
`;
  const step = await shell(context, [], [], script, []);

  return new Artifact("bun", [step], SYSTEMS)
    .withAliases([`bun:${bunVersion}`])
    .withSources([source])
    .build(context);
}

async function main(): Promise<void> {
  const context = ConfigContext.create();

  const toolDigests: string[] = [];
  for (const alias of tools) {
    toolDigests.push(await context.fetchArtifactAlias(alias));
  }

  // The TypeScript development environment carries the SDK's bun.
  await new TypeScriptDevelopmentEnvironment(devEnvironment, SYSTEMS)
    .withArtifacts(toolDigests)
    .build(context);

  const bun = await buildBun(context);
  const step = await shell(context, [bun], [], buildScript, []);
  const source = new ArtifactSource(frontend, ".")
    .withExcludes(sourceExcludes)
    .withIncludes(sourceIncludes)
    .build();

  await new Artifact(frontend, [step], SYSTEMS)
    .withSources([source])
    .build(context);

  await context.run();
}

void main();
